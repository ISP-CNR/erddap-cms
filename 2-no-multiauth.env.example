# Specify the GeoNetwork URL
GEONETWORK_URL="https://example.org/geonetwork"

PUBLISHER_NAME="My Awesome Data Center"
PUBLISHER_URL="https://example.com"

TITLE="My Awesome ERDDAP"

FLASK_APP="/var/www/html/frontend/main"
FLASK_ENV="production"
URL_PATH="/erddap-cms"

NO_MULTIAUTH=False

ERDDAP_bigParentDirectory="/erddapData/"
ERDDAP_baseUrl="http://devel-example.org:8080"
ERDDAP_flagKeyKey=

ERDDAP_emailEverythingTo=admin@example.org
ERDDAP_emailDailyReportsTo=
ERDDAP_emailFromAddress=admin@example.org
ERDDAP_emailUserName=admin@example.org
ERDDAP_emailPassword=
ERDDAP_emailProperties=mail.smtp.starttls.enable|true
ERDDAP_emailSmtpHost=smtp-istituti.cnr.it
ERDDAP_emailSmtpPort=465
ERDDAP_emailUseTLS=False
ERDDAP_emailUseSSL=True
ERDDAP_emailSender=noreply@example.org

ERDDAP_adminInstitution="Axiom Docker Install"
ERDDAP_adminInstitutionUrl="https://github.com/axiom-data-science/docker-erddap"
ERDDAP_adminIndividualName="Axiom Docker Install"
ERDDAP_adminPosition="Software Engineer"
ERDDAP_adminPhone="555-555-5555"
ERDDAP_adminAddress="123 Irrelevant St."
ERDDAP_adminCity="Nowhere"
ERDDAP_adminStateOrProvince="AK"
ERDDAP_adminPostalCode="99504"
ERDDAP_adminCountry="USA"
ERDDAP_adminEmail="nobody@example.com"

ERDDAP_highResLogoImageFile="logo.png"
ERDDAP_lowResLogoImageFile="logo.png"
ERDDAP_googleEarthLogoFile="logo.png"
ERDDAP_variablesMustHaveIoosCategory="false"
ERDDAP_categoryAttributes="global:cdm_data_type, global:institution, global:keywords, long_name, standard_name, variableName"